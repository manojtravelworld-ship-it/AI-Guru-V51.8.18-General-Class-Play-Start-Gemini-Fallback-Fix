# AI Guru external providers only. No localhost renderer URLs are required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# Optional: server-side document service, only if you choose to deploy one.
# DOCLING_URL=

# Optional Piper integration. Prefer direct local Piper when the model is downloaded.
# Windows example: PIPER_BIN=C:\path\to\piper.exe
# PIPER_BIN=
# PIPER_MODEL=
# Alternatively use a local HTTP Piper service:
# PIPER_TTS_URL=http://127.0.0.1:5001/tts

# Classroom TTS priority: Edge TTS -> Google Cloud TTS -> Sarvam/Piper.
# Edge TTS is server-side; no browser SpeechSynthesis fallback is used.
EDGE_TTS_EN_VOICE=en-IN-NeerjaNeural
EDGE_TTS_ML_VOICE=ml-IN-SobhanaNeural

# Google Cloud TTS (server-side only).
# Preferred: a Google Cloud API key that is authorized/restricted for Cloud TTS.
# IMPORTANT: a Gemini Developer/AI Studio API key is not automatically a Cloud TTS credential.
GOOGLE_CLOUD_TTS_API_KEY=
# Set true only if GEMINI_API_KEY is intentionally a Google Cloud API key that
# is valid for Cloud TTS in the same project.
GOOGLE_CLOUD_TTS_USE_GEMINI_KEY=false
# Or use Google Application Default Credentials / service-account credentials.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\google-cloud-credentials.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_TTS_EN_VOICE=en-IN-Neural2-A
GOOGLE_TTS_ML_VOICE=ml-IN-Standard-A

# Visual Developer (V50): pattern search -> build -> dry run for steps that have no picture. On by default; set 0 to turn off.
NEXT_PUBLIC_AI_GURU_VISUAL_DEVELOPER=1

# Video-template grounding (V51 corrected): Gemini inspects the selected approved
# reference video and extracts temporal teaching beats before generating visuals.
# Set to 0 only when you intentionally want metadata/prompt-only grounding.
AI_GURU_MATH_RAG_WATCH_VIDEO=0
# Videos up to this size are sent inline; larger files use Gemini Files API.
AI_GURU_MATH_RAG_VIDEO_INLINE_MAX_BYTES=18000000
AI_GURU_MATH_RAG_FAISS=0

# V51.5 K-12 Visual DNA runtime
# General classroom: use 69 curated local Manim/code Visual-DNA patterns; do not search giant FAISS pools.
AI_GURU_K12_VISUAL_DNA=1
# Physical reference video watching remains opt-in only (problem-solving enrichment/diagnostics).
AI_GURU_MATH_RAG_WATCH_VIDEO=0
